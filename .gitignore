# =============================================================================
# Classora monorepo .gitignore
# Must stay tracked: uv.lock, pnpm-lock.yaml, .env.example, .gitkeep,
# .python-version, .terraform.lock.hcl
# =============================================================================

# --- Environment and secrets -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Python (apps/api) -------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/

# --- Build output (Python and Node) ------------------------------------------
dist/
build/

# --- Node / Vite (apps/web, packages/*) --------------------------------------
node_modules/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- E2E / Playwright (e2e/) -------------------------------------------------
test-results/
playwright-report/
blob-report/

# --- Terraform (infrastructure/terraform) ------------------------------------
# .terraform.lock.hcl is intentionally tracked.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# --- OS and editors ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*.log
