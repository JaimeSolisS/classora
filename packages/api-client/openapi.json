{
  "openapi": "3.1.0",
  "info": {
    "title": "Classora API",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live",
        "description": "The process is up. Never touches the database.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "description": "The process is up and PostgreSQL answers ``SELECT 1`` (pooled engine).",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "The database is not reachable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Sign in with a username and password; sets the session cookie.\n\nEvery login issues a new session; a live session on the request's cookie\nis revoked. Any failure is the same ``401 invalid_credentials``. The body\ncarries the new session's ``csrf_token``. Needs the app's ``Origin``.\nToo many attempts from one IP or for one username: ``429 rate_limited``\nwith ``Retry-After``, whether or not the account exists.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUser"
                }
              }
            }
          },
          "401": {
            "description": "The username or password is incorrect.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The request could not be verified (csrf_failed): the Origin or the X-CSRF-Token check failed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts (rate_limited). Retry after the number of seconds in Retry-After.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the limit's window ends.",
                "schema": {
                  "type": "integer",
                  "minimum": 1.0
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "Sign out: revoke the current session and clear the cookie.\n\nNeeds the app's ``Origin`` and the session's ``X-CSRF-Token``.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The request could not be verified (csrf_failed): the Origin or the X-CSRF-Token check failed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "description": "The signed-in user, their roles, their effective permissions and the\nsession's CSRF token (the same value for the whole session).",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUser"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/reauthenticate": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Reauthenticate",
        "description": "Confirm the signed-in user's password for sensitive actions.\n\nOn success the **current** session counts as reauthenticated for 5\nminutes from now (activity does not extend it; a later reauthentication\nrestarts it). A wrong password is ``403 reauth_failed``; the session stays\nsigned in and its window is unchanged. Needs the app's ``Origin`` and the\nsession's ``X-CSRF-Token``. After 5 wrong passwords for the user in a\n15-minute window, further attempts get ``429 rate_limited`` with\n``Retry-After``, without a password check; the session and its window are\nunchanged.",
        "operationId": "reauthenticate_api_v1_auth_reauthenticate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReauthenticateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReauthenticateResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The password is incorrect (reauth_failed), or a failed Origin or X-CSRF-Token check (csrf_failed).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts (rate_limited). Retry after the number of seconds in Retry-After.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the limit's window ends.",
                "schema": {
                  "type": "integer",
                  "minimum": 1.0
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit-events": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "List Events",
        "description": "The audit log, newest first, filtered by record, actor and time range.",
        "operationId": "list_events_api_v1_audit_events_get",
        "parameters": [
          {
            "name": "record_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z_]{1,63}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Table name, with record_id.",
              "title": "Record Type"
            },
            "description": "Table name, with record_id."
          },
          {
            "name": "record_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Record id, with record_type.",
              "title": "Record Id"
            },
            "description": "Record id, with record_type."
          },
          {
            "name": "actor_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Events written by this user.",
              "title": "Actor Id"
            },
            "description": "Events written by this user."
          },
          {
            "name": "occurred_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive lower bound.",
              "title": "Occurred From"
            },
            "description": "Inclusive lower bound."
          },
          {
            "name": "occurred_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exclusive upper bound.",
              "title": "Occurred To"
            },
            "description": "Exclusive upper bound."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 25,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CursorPage_AuditEventListItem_"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied (permission_denied); on POST, PUT, PATCH and DELETE also a failed Origin or X-CSRF-Token check (csrf_failed).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "The pagination cursor is not valid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditChange": {
        "properties": {
          "old": {
            "title": "Old"
          },
          "new": {
            "title": "New"
          }
        },
        "type": "object",
        "required": [
          "old",
          "new"
        ],
        "title": "AuditChange",
        "description": "One column's value before and after the change (null when there is none)."
      },
      "AuditEventListItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "actor_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Id"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "record_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Record Type"
          },
          "record_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Record Id"
          },
          "changes": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/AuditChange"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Changes"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "occurred_at",
          "actor_id",
          "action",
          "record_type",
          "record_id",
          "changes",
          "details",
          "request_id"
        ],
        "title": "AuditEventListItem",
        "description": "One audit event; the actor and the record are given by id."
      },
      "CursorPage_AuditEventListItem_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditEventListItem"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "CursorPage[AuditEventListItem]"
      },
      "FieldError": {
        "additionalProperties": false,
        "description": "One field-level error: location, Pydantic error type and message.",
        "properties": {
          "path": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Path",
            "type": "array"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "path",
          "code",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "description": "The success body of both health probes."
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "description": "Username and password. The bounds do not depend on any account."
      },
      "PermissionCode": {
        "type": "string",
        "enum": [
          "audit.view",
          "catalog.manage",
          "consent.record",
          "family.manage",
          "finance.refund.approve",
          "guardian.view",
          "payroll.finalize",
          "registration.review",
          "schedule.override",
          "student.manage",
          "student.view",
          "user.admin_role.assign",
          "user.delegation.manage",
          "user.invite",
          "user.manage",
          "user.owner_role.assign",
          "user.password_reset.issue",
          "user.role.assign",
          "user.view"
        ]
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "description": "The body of every error response (RFC 9457 Problem Details).",
        "properties": {
          "type": {
            "const": "about:blank",
            "title": "Type",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ReauthenticateRequest": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "ReauthenticateRequest",
        "description": "The current user's password (#26). The same bounds as login."
      },
      "ReauthenticateResponse": {
        "properties": {
          "reauthenticated_until": {
            "type": "string",
            "format": "date-time",
            "title": "Reauthenticated Until",
            "description": "When the 5-minute reauthentication window of this session ends (ISO 8601, UTC). Activity does not extend it."
          }
        },
        "type": "object",
        "required": [
          "reauthenticated_until"
        ],
        "title": "ReauthenticateResponse",
        "description": "The end of the session's reauthentication window (#26).\n\nHolds no token, hash or session id."
      },
      "RoleCode": {
        "type": "string",
        "enum": [
          "academic_coordinator",
          "administrator",
          "finance_staff",
          "guardian",
          "owner",
          "student",
          "tutor"
        ]
      },
      "SessionUser": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/RoleCode"
            },
            "type": "array",
            "title": "Roles",
            "description": "Role codes, sorted."
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/PermissionCode"
            },
            "type": "array",
            "title": "Permissions",
            "description": "Effective permission codes, sorted."
          },
          "csrf_token": {
            "type": "string",
            "maxLength": 43,
            "minLength": 43,
            "title": "Csrf Token",
            "description": "The session's CSRF token: send it as X-CSRF-Token on POST, PUT, PATCH and DELETE. Keep it in memory only."
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name",
          "roles",
          "permissions",
          "csrf_token"
        ],
        "title": "SessionUser",
        "description": "The signed-in user (``POST /auth/login`` and ``GET /auth/me``).\n\nHolds no password hash, session token or session id. ``csrf_token`` is\nthe session's CSRF token: the SPA keeps it in memory and sends it as\n``X-CSRF-Token`` on ``POST``, ``PUT``, ``PATCH`` and ``DELETE``."
      }
    }
  }
}
