# Local development only. Copy to .env (git-ignored; never commit .env).
# Every value here is a placeholder for the local Compose stack, never a real
# credential. The AWS hosts don't use this file: render-env.sh writes their
# env file from Parameter Store (ADR-0012, _docs/runbooks/host.md). The API validates its variables at startup and refuses to start
# on a missing or invalid value (see `docker compose logs api`).

# --- Compose: PostgreSQL and PgBouncer containers and the host ports (read by
# the Compose files, not by the API). `docker compose` loads compose.yaml (which
# pulls the services in from infrastructure/docker/compose.{data,app}.yaml with
# `extends:`) and compose.override.yaml (host ports for db and pgbouncer,
# 127.0.0.1 only).
# Required. Database user created in the local db container: the database
# OWNER (a superuser locally). Only the tools use it: migrations, seeds and
# operator commands (`make migrate`, `make seed`, `make bootstrap-owner`, the
# Compose `migrate` service). Never passed to the api or worker containers.
POSTGRES_USER=classora
# Required. Password of that user (local placeholder only).
POSTGRES_PASSWORD=classora_local_only
# Required. Password of the least-privilege runtime role `classora_app` the API
# and worker log in as (local placeholder only; #165). Migration 0096 creates
# the role and `make migrate` (python -m app.cli sync-runtime-role) sets this
# password, so run `make migrate` before `make dev`. PgBouncer's auth file and
# the api and worker URLs are built from it.
POSTGRES_APP_PASSWORD=classora_app_local_only
# Required. Database created in the local db container.
POSTGRES_DB=classora
# Optional (default 5432). Host port the db container is published on (127.0.0.1 only).
POSTGRES_PORT=5432
# Optional (default 6432). Host port the pgbouncer container is published on (127.0.0.1 only).
PGBOUNCER_PORT=6432
# Optional (default 8000). Host port the api container is published on (127.0.0.1 only).
API_PORT=8000
# Optional (default 5173). Host port the web container is published on (127.0.0.1 only).
WEB_PORT=5173

# --- API and worker settings (read by the app; passed to the api and worker
# containers by the Compose files)
# Required. Environment name: local, dev or prod.
APP_ENV=local
# Required (API). The web app's origin: scheme, host and port, no path (no
# trailing /). Unsafe API requests (POST, PUT, PATCH, DELETE) whose Origin
# header differs get 403 csrf_failed, so open the app at exactly this address
# (127.0.0.1, not localhost). Change it together with WEB_PORT. http is
# accepted only with APP_ENV=local.
APP_ORIGIN=http://127.0.0.1:5173
# Three database URLs (ADR-0003 amendment, #165). The two the API and worker
# read carry the runtime role classora_app; the third, read only by the tools,
# carries the owner. These values are for runs on the host; inside Compose the
# api, worker and migrate services build their own from the POSTGRES_* values.
# Required (API). Pooled DSN, through PgBouncer, as classora_app: the API's
# request traffic.
DATABASE_URL=postgresql://classora_app:classora_app_local_only@127.0.0.1:6432/classora
# Required (API and worker). Direct DSN to PostgreSQL, bypassing PgBouncer, as
# classora_app: the API's LISTEN connection and the worker.
DATABASE_DIRECT_URL=postgresql://classora_app:classora_app_local_only@127.0.0.1:5432/classora
# Optional (tools only). Direct DSN as the database owner: Alembic, the seeds,
# the operator CLI and the local data factories. The API and worker never read
# it. Unset: the tools use DATABASE_DIRECT_URL, and as classora_app migrations
# fail (no DDL).
DATABASE_MIGRATION_URL=postgresql://classora:classora_local_only@127.0.0.1:5432/classora
# Optional (API, default true). The session cookie mode. true (every deployed
# environment): the cookie __Host-classora_session with Secure. false (this
# local file): local plain HTTP uses the cookie classora_session without Secure.
# false is refused unless APP_ENV=local.
SESSION_COOKIE_SECURE=false
# Optional (worker, default 20, 1-30). Seconds a stopping worker waits for
# running jobs to finish before aborting them.
WORKER_SHUTDOWN_TIMEOUT_SECONDS=20
# Optional (API and worker, default 12, 4-26). How many weeks ahead recurring
# series occurrences are generated: at series creation and by the nightly
# job (08:00 UTC). An operator setting, not a business setting.
SCHEDULING_HORIZON_WEEKS=12
# Optional (API, default empty). Proxies whose X-Forwarded-For header the API
# believes when it finds the client IP for rate limits: comma-separated IP
# addresses or CIDR networks (0.0.0.0/0 and ::/0 are refused). Empty: no proxy
# is trusted and the client is always the connection's peer. Keep it empty
# locally. On the AWS hosts it is the edge's fixed address, 172.30.0.10/32
# (infrastructure/host/compose.aws.yaml; ADR-0010).
TRUSTED_PROXIES=
# Optional (API, default 600, 0-100000). The general API rate limit: requests
# per minute per API process and client IP (the health probes are never
# counted); beyond it the API answers 429. 0 turns it off. The login and
# other authentication limits are separate and always on (ADR-0008).
API_RATE_LIMIT_PER_MINUTE=600

# Optional (API). Object storage; not used until M5-02, leave empty.
# Bucket name for stored documents.
STORAGE_BUCKET=
# Region of the bucket.
STORAGE_REGION=
# http(s) URL of a local S3-compatible emulator.
STORAGE_ENDPOINT_URL=
# Access key ID; set together with STORAGE_SECRET_ACCESS_KEY or leave both empty.
STORAGE_ACCESS_KEY_ID=
# Secret access key; set together with STORAGE_ACCESS_KEY_ID or leave both empty.
STORAGE_SECRET_ACCESS_KEY=

# --- Optional local observability (`make dev-observability`; off by default,
# needs about 700 MB more RAM; _docs/Full_README.md "Observability (optional)")
# Optional (default 3000). Host port Grafana is published on (127.0.0.1 only).
GRAFANA_PORT=3000
# Required by `make dev-observability`. Password of Grafana's `admin` user
# (local placeholder only; not empty and not "admin"). Grafana stores it on its
# first start; to change it later, run `make dev-observability-down V=1` first.
GRAFANA_ADMIN_PASSWORD=grafana_local_only
# Optional (API and worker). OTLP/HTTP endpoint the API and worker export traces,
# metrics and logs to (ADR-0014, #612). Leave it empty: telemetry is off and no
# OpenTelemetry SDK object is created. `make dev-observability` sets it to the
# local collector (http://otel-collector:4318); `make dev` leaves it empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
