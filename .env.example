# Local development only. Copy to .env (never commit .env).
# These are placeholder credentials for the local Compose PostgreSQL.

# PostgreSQL container settings (used by compose.yaml)
POSTGRES_USER=classora
POSTGRES_PASSWORD=classora_local_only
POSTGRES_DB=classora
# Host port PostgreSQL is published on (bound to 127.0.0.1 only)
POSTGRES_PORT=5432

# DSN used by the API and tests running on the host (make test).
# Keep user, password, port and database in sync with the values above.
# Inside Compose, the api service builds its own DSN pointing at the db service.
DATABASE_URL=postgresql://classora:classora_local_only@127.0.0.1:5432/classora
