# Nightly logical backup of the database to the ops bucket (ADR-0013, #616),
# started by classora-backup.timer. backup.sh logs one JSON result line to the
# journal and to /var/log/classora/backup.log; a failure fails the unit.
[Unit]
Description=Classora nightly database backup (pg_dump to S3)
Requires=docker.service
After=docker.service classora-data.service network-online.target
Wants=network-online.target
# A new host (PROD's first boot) has the timer from its user data but neither
# backup.sh (release-only) nor a database until the first release: skip, don't
# fail (QA #616 O4). A skipped run is not a success: the "no successful backup
# in 26 hours" alert still covers a host with a running app (#617).
ConditionPathExists=/opt/classora/bin/backup.sh
ConditionPathExists=/srv/classora-data/releases/current/images.env

[Service]
Type=oneshot
ExecStart=/opt/classora/bin/backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3600
