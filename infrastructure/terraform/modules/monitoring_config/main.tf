# The monitoring stack's settings (ADR-0012, ADR-0014; M9-09, #617), used by
# the dedicated monitoring host (modules/monitoring_host) or by envs/<env>
# when the stack is colocated on an app host. Only one of them exists at a
# time (the roots' preconditions): the SMTP user and the shared endpoint
# parameter have fixed names.
#
# - Grafana's admin password: random, SecureString.
# - SES SMTP credentials: an IAM user allowed only ses:SendRawEmail from
#   alerts@<domain>; its key's SMTP password (SigV4, this region). Both
#   SecureString. The key also sits in the (encrypted) Terraform state.
# - Plain settings: Grafana's host, the alert recipient, the SMTP endpoint and
#   sender, retention, and (dedicated) the private ingest address.
# - /classora/shared/otlp_endpoint: the gateway, read by every app host's
#   render-env.sh; while it exists the agents and the app's exporter run.

data "aws_region" "current" {}

locals {
  region = data.aws_region.current.region
  from   = "alerts@${var.domain_name}"
}

resource "random_password" "grafana_admin" {
  length  = 40
  special = false
}

resource "aws_iam_user" "ses_smtp" {
  name = "classora-ses-smtp"
  path = "/classora/"
}

data "aws_iam_policy_document" "ses_smtp" {
  statement {
    sid       = "SendAlertsOnly"
    actions   = ["ses:SendRawEmail"]
    resources = ["*"]

    condition {
      test     = "StringEquals"
      variable = "ses:FromAddress"
      values   = [local.from]
    }
  }
}

resource "aws_iam_user_policy" "ses_smtp" {
  name   = "classora-ses-smtp"
  user   = aws_iam_user.ses_smtp.name
  policy = data.aws_iam_policy_document.ses_smtp.json
}

resource "aws_iam_access_key" "ses_smtp" {
  user = aws_iam_user.ses_smtp.name
}

locals {
  secrets = {
    grafana_admin_password = random_password.grafana_admin.result
    smtp_username          = aws_iam_access_key.ses_smtp.id
    smtp_password          = aws_iam_access_key.ses_smtp.ses_smtp_password_v4
  }

  plain = merge(
    {
      grafana_host = var.grafana_host
      alert_email  = var.alert_email
      smtp_host    = "email-smtp.${local.region}.amazonaws.com:587"
      smtp_from    = local.from
      # Prometheus takes days; Loki and Tempo take hours.
      retention_metrics = "${var.retention_metrics_days}d"
      retention_logs    = "${var.retention_logs_days * 24}h"
      retention_traces  = "${var.retention_traces_days * 24}h"
    },
    var.ingest_address == null ? {} : { ingest_address = var.ingest_address },
    var.extra_parameters,
  )
}

resource "aws_ssm_parameter" "secret" {
  for_each = nonsensitive(toset(keys(local.secrets)))

  name        = "${var.parameter_prefix}/${each.key}"
  description = "Classora monitoring: ${each.key} (generated by Terraform)."
  type        = "SecureString"
  value       = local.secrets[each.key]
}

resource "aws_ssm_parameter" "plain" {
  for_each = nonsensitive(toset(keys(local.plain)))

  name        = "${var.parameter_prefix}/${each.key}"
  description = "Classora monitoring: ${each.key}."
  type        = "String"
  value       = local.plain[each.key]
}

resource "aws_ssm_parameter" "otlp_endpoint" {
  name        = "/classora/shared/otlp_endpoint"
  description = "Classora: the monitoring gateway's OTLP/HTTP endpoint (ADR-0014). Absent: telemetry off."
  type        = "String"
  value       = var.otlp_endpoint
}
