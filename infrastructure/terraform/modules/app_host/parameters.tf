# Parameter Store (ADR-0012): generated secrets as SecureString (AWS-managed
# aws/ssm key) and plain settings as String, under /classora/<env>/. The host
# renders them into a root-only env file (render-env.sh). Letters and digits
# only: the passwords are interpolated into PostgreSQL URLs and env files.

resource "random_password" "db" {
  for_each = toset(["postgres_password", "app_db_password", "monitor_db_password"])

  length  = 40
  special = false
}

resource "aws_ssm_parameter" "secret" {
  for_each = random_password.db

  name        = "/classora/${var.env}/${each.key}"
  description = "Classora ${var.env}: ${each.key} (generated by Terraform)."
  type        = "SecureString"
  value       = each.value.result
}

locals {
  plain_parameters = {
    app_origin     = "https://${var.hostnames[0]}"
    site_addresses = join(", ", var.hostnames)
    acme_ca        = var.acme_ca
    instance_id    = aws_instance.this.id
  }
}

resource "aws_ssm_parameter" "plain" {
  for_each = local.plain_parameters

  name        = "/classora/${var.env}/${each.key}"
  description = "Classora ${var.env}: ${each.key}."
  type        = "String"
  value       = each.value
}
